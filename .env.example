# GEMINI_API_KEY: Required for server-side Gemini AI, transcription, and embedding calls.
# AI Studio automatically injects this at runtime from Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configurable AI Provider & Model Routing (Server-Side Only)
AI_PROVIDER="gemini"
AI_TEXT_MODEL="gemini-4-hydrogen"
AI_TRANSCRIBE_MODEL="gemini-3.5-transcribe"
AI_EMBEDDING_MODEL="gemini-embedding-2"
AI_LIVE_MODEL="gemini-3.8-live"

# Optional Future Provider Placeholders (Not active unless configured)
OPENAI_API_KEY=""

# Configurable Freemium Limits (Overrides for default student tier)
FREE_MONTHLY_RECORDING_MINUTES="120"
FREE_DAILY_AI_MESSAGES="40"
FREE_STORAGE_LIMIT_MB="250"

# Future Payment Integration Placeholders (M-Pesa Daraja / Card Webhooks)
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""
MPESA_PASSKEY=""
PAYMENT_WEBHOOK_SECRET=""

# Bootstrapped Administrator Emails (Comma-separated)
ADMIN_EMAILS="austinelapi@gmail.com"
